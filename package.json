{
  "name": "beparibd-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "//tokenScope": [
    "The design-token discipline — no raw hex, no arbitrary Tailwind values —",
    "is enforced across ALL of src/, unconditionally. See scripts/guard.sh.",
    "This used to be a scoped allowlist that widened as each area was migrated.",
    "The migration is finished and the scope was dropped; the note stays only",
    "because a stale backlog here reads as work outstanding when there is none."
  ],
  "scripts": {
    "dev": "vite --mode dev-local",
    "dev:local": "vite --mode dev-local",
    "dev:gcp": "vite --mode dev-gcp",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run guard",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run guard",
    "guard": "bash scripts/guard.sh",
    "guard:selftest": "bash scripts/guard-selftest.sh",
    "design:preview": "node scripts/build-design-preview.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.574.0",
    "nextgen-password": "file:../bepari-password",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.57.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
