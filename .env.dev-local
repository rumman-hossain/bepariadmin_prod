# ============================================================================
# PROFILE: dev-local  —  npm run dev:local
# ============================================================================
# Proxy /api, /health and /uploads to a backend running on this machine.
# Start it first: cd ../beparibd-backend && make local && make dev
#
# Named .env.dev-local rather than .env.local on purpose: Vite treats
# `.env.local` as an all-modes override and loads it even under --mode dev-gcp,
# which would make the two profiles bleed into each other.
#
# Commit this file — it holds no secrets.
# ============================================================================

VITE_API_PROXY_TARGET=http://localhost:8080
