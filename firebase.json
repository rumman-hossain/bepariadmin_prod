{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
      "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "beparibd-backend-dev", "region": "asia-southeast1" } },
      { "source": "/health", "run": { "serviceId": "beparibd-backend-dev", "region": "asia-southeast1" } },
      { "source": "/uploads/**", "run": { "serviceId": "beparibd-backend-dev", "region": "asia-southeast1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
