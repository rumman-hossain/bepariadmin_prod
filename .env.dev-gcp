# ============================================================================
# PROFILE: dev-gcp  —  npm run dev:gcp
# ============================================================================
# Proxy /api, /health and /uploads to the DEPLOYED dev backend on Cloud Run.
# No local Go server needed — useful for pure UI work, or to check whether a
# bug is yours or the deployed service's.
#
# This is the same service firebase.json rewrites to in production, so the app
# behaves as it does on the hosted dev site.
#
# ⚠️  Real dev data and real outbound email. Anything you change here, changes
#     for everyone using the dev environment.
#
# Commit this file — it holds no secrets.
# ============================================================================

VITE_API_PROXY_TARGET=https://beparibd-backend-dev-ckuryct3nq-as.a.run.app
